# Copy this file to .env before deployment.

# Initial admin username and password. Change both before use.
# These are used only to create the first admin user in a new SQLite database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Stable encryption key for refresh_token storage.
# Do not change it after importing accounts, or saved tokens cannot be decrypted.
DATA_KEY=change-this-to-a-long-random-secret

# Host port exposed by docker-compose.
PORT=8009

# Inside Docker this should stay 0.0.0.0.
HOST=0.0.0.0

# Public registration is disabled by default to prevent abuse.
# When enabled, users still need a database invite generated by an admin.
REGISTRATION_ENABLED=false
